# Copy this file to .env and change JWT_SECRET before using outside local development
DATABASE_URL="postgresql://brew:brew_dev_password@localhost:5432/brewlite?schema=public"
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="1d"
PORT=3001
FRONTEND_ORIGIN="http://localhost:3000"

PAYMENT_MODE=simulation
SEED_DEMO_ACCOUNTS=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/payment-return

# Real bank transfer: configure privately; never commit receiving account data.
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

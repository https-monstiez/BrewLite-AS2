# Copy to .env on VPS only, chmod 600 .env. Use separate random HEX passwords.
DOMAIN=coffee.example.com
ACME_EMAIL=your-email@example.com
IMAGE_REGISTRY=ghcr.io/https-monstiez/brewlite-as2
IMAGE_TAG=REPLACE_WITH_VERIFIED_40_CHARACTER_COMMIT_SHA
DB_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_MIGRATION_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
DB_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_HEX
PAYMENT_MODE=simulation
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

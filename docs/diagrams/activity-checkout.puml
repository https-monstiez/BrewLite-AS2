@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName SansSerif
|Customer|
start
:Browse, choose options, add to cart;
if (Logged in?) then (no)
 :Register / log in;
endif
:Request quote and submit order with stable key;
|NestJS API|
:Validate JWT / DTO, price, voucher, inventory;
if (Valid and in stock?) then (no)
 |Customer|
 :Display validation / out-of-stock error;
 stop
endif
|NestJS API|
:Transaction: reserve stock, create PENDING;
|Customer|
:Choose bank transfer or loyalty points;
|PaymentsService|
if (Loyalty points?) then (yes)
 :Transaction: check balance;
 if (Enough points?) then (no)
  |Customer|
  :Show insufficient balance; order stays PENDING;
  if (Cancel pending order?) then (yes)
   |NestJS API|
   :CANCELLED; restore reserved stock once;
  endif
  stop
 endif
 |PaymentsService|
 :Deduct points; record payment / ledger once;
else (bank transfer)
 :Create pending bank payment and instructions;
 |Customer|
 :View VietQR / transfer in external bank app;
 |Staff|
 :Check bank statement and received amount/reference;
 if (Receipt verified?) then (no)
  |Customer|
  :Order stays PENDING; track or cancel;
  stop
 endif
 |NestJS API|
 :Check STAFF / ADMIN role;
 |PaymentsService|
 :Atomically claim pending payment;
 :Record receipt and earned points once;
endif
|NestJS API|
:Order PAID;
|Customer|
:Read order status from API;
|Staff|
:PAID -> PREPARING -> READY -> COMPLETED;
stop
@enduml

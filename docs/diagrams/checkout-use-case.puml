@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName SansSerif
left to right direction
actor Customer
actor "Staff / ADMIN" as Staff
rectangle "UC-01 Order and pay" {
 usecase "Create order" as order
 usecase "Authenticate / validate" as validate
 usecase "Server quote" as quote
 usecase "Reserve stock atomically" as reserve
 usecase "Bank transfer (VietQR)" as bank
 usecase "Redeem loyalty points" as points
 usecase "Verify received transfer" as reconcile
 usecase "Read authoritative order status" as status
 usecase "Cancel pending order / restore stock" as cancel
}
Customer --> order
Customer --> bank
Customer --> points
Customer --> status
Customer --> cancel
Staff --> reconcile
order ..> validate : <<include>>
order ..> quote : <<include>>
order ..> reserve : <<include>>
bank ..> order : <<extend>>
points ..> order : <<extend>>
reconcile ..> status : updates after verification
note bottom of bank
Bank transfer stays PENDING until staff reconciliation.
Insufficient points reject payment without marking PAID.
end note
@enduml

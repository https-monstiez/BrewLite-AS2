@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName SansSerif
title BrewLite AS2 — production topology and verified CI deploy path (15 Nov 2026)

node "Developer / Local" {
  node "Docker Compose" {
    artifact "Next.js web :3000" as localweb
    artifact "NestJS API :3001/api" as localapi
    database "PostgreSQL :5432\npersistent local volume" as localdb
    localweb --> localapi : HTTP
    localapi --> localdb : private Compose network
  }
}

node "GitHub — BrewLite-AS2" {
  artifact "main branch\nsource commit from workflow" as source
  node "GitHub Actions" {
    artifact "CI quality gate\nlint, tests, build, PostgreSQL,\nPlaywright E2E" as ci
    artifact "Delivery\nbuild Docker images\npinned by commit SHA" as delivery
    artifact "CI deploy + smoke\nverified run 43685179367" as cideploy
  }
  node "GHCR" {
    artifact "API and web images\ncommit-SHA tags" as images
  }
  source --> ci : PR / push
  ci --> delivery : success
  delivery --> images : push
}

node "Production — Vercel + Render" {
  node "Vercel Hobby" {
    artifact "Next.js production web\nHTTPS / Edge Network" as web
    artifact "/version\nruntime commit SHA" as webversion
    web --> webversion
  }
  node "Render — Singapore" {
    artifact "Git-backed Docker Web Service\nbrewlite-as2-api\nPORT /api/health" as api
    database "Render PostgreSQL Free\npersistent managed storage\nprivate inbound rules\nno public IP ranges" as db
    artifact "Environment configuration\nDATABASE_URL from database\nJWT and bank settings" as secrets
    artifact "Render service logs" as logs
    api --> db : internal connection string\nPostgreSQL TCP
    secrets ..> api : injected environment
    api --> logs
  }
  source --> web : Vercel Git integration\nproduction deployment
  source --> api : Render Blueprint\nmain / checksPass (current)
  delivery ..> cideploy : after image / main only
  cideploy ..> api : verified: Render API commitId\nsecret from GitHub
  cideploy ..> web : verified: deploy hook main\nthen web/API SHA smoke
}

node "Customer device" {
  artifact "Browser / installed PWA" as client
}

cloud "VNPay Sandbox\noptional; requires merchant config" as vnp
client --> web : HTTPS 443
client --> api : HTTPS 443 / REST + JWT
api --> vnp : signed payment URL (when configured)
vnp --> api : HTTPS Return / IPN

note right of cideploy
CI deploy path verified by run 43685179367.
Quality, image, deploy and smoke succeeded.
Platform Git deployments remain separate mechanisms.
end note
note right of images
GHCR image build/push is verified
by GitHub Delivery. The current Render
service deploys from Git, not GHCR.
end note
note bottom of db
Render dashboard: PostgreSQL Inbound IP Rules
is empty; Internet traffic to PostgreSQL is blocked.
Free database deletion notice: 15 Dec 2026.
end note
note bottom of web
Verified deployment snapshot, 15 Nov 2026:
web/API SHA 2af63a27619e7062e94bc6163643448e08a1b7f8
See docs/deployment.md for run evidence and later versions.
end note
@enduml

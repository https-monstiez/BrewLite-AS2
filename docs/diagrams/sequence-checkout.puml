@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName SansSerif
actor Customer
actor Staff
participant "Next.js UI" as UI
participant "NestJS API" as API
database PostgreSQL as DB
participant "PaymentsService" as Payment
Customer -> UI : Options, cart, checkout
UI -> API : POST /api/orders/quote + JWT
API -> API : Validate JWT / DTO
API -> DB : Read prices, voucher, stock
API --> UI : Server quote
UI -> API : POST /api/orders + stable Idempotency-Key
API -> DB : Check key and payload
alt same key and payload
 API --> UI : Existing order (no duplicate reservation)
else new request
 API -> DB : BEGIN; conditional stock/version update
 alt out of stock / update conflict
  API -> DB : ROLLBACK
  API --> UI : Reject or bounded retry
 else reserved
  API -> DB : INSERT Order/OrderItem; COMMIT
  API --> UI : PENDING order and server total
 end
end
UI -> API : POST /api/payments + stable key
API -> Payment : Create payment for owned order
alt BANK_TRANSFER
 Payment -> DB : Unique pending payment / lock order
 Payment --> API : Pending bank payment
 UI -> API : GET /api/payments/bank-transfer/:orderId
 API --> UI : VietQR instructions (DB amount/reference)
 note over Customer,UI : External bank app transfers funds; QR display alone is not proof.
 Staff -> API : POST /api/payments/:orderId/confirm + JWT
 API -> API : Verify STAFF / ADMIN role
 API -> Payment : Confirm verified receipt
 Payment -> DB : Conditional PENDING -> PAID;
 Payment -> DB : Payment SUCCEEDED + earned points / ledger
 Payment --> API : Success; duplicate confirmation -> 409
else LOYALTY_POINTS
 Payment -> DB : BEGIN; check and deduct sufficient points
 alt insufficient balance
  Payment -> DB : ROLLBACK payment transaction
  Payment --> API : 400; order remains PENDING
 else sufficient balance
  Payment -> DB : PAID + SUCCEEDED + points ledger; COMMIT
  Payment --> API : Success; idempotent retry returns same result
 end
end
API --> UI : Current payment result
UI -> API : GET /api/orders/:id + JWT
API -> DB : Read owned order
API --> UI : Authoritative total/status
UI --> Customer : Confirmation or pending/error
opt customer cancels a pending order
 UI -> API : POST /api/orders/:id/cancel
 API -> DB : Conditional cancel; restore reserved stock once
 API --> UI : CANCELLED
end
@enduml
